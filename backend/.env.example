# ── 数据库 ──────────────────────────────
DATABASE_URL="file:./data/village.db"

# ── 服务 ────────────────────────────────
PORT=8000
NODE_ENV=development

# ── JWT ─────────────────────────────────
JWT_SECRET=village-dev-secret-change-me
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── Ollama 本地 AI ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_VISION_MODEL=minicpm-v:8b-2.6-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3

# ── 文件上传 ────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── 管理面板账号 ────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=village2025
ADMIN_JWT_SECRET=village-admin-secret-change-me
