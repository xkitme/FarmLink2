# ── 数据库 ──────────────────────────────
DATABASE_URL="file:../data/village.db"

# ── 服务 ────────────────────────────────
PORT=8000
NODE_ENV=development
# dev：本机开发；demo：比赛离线包；release：正式发布
APP_ENV=dev
# 仅 db:seed 使用；demo 必须显式设置，release 禁止执行种子脚本
# SEED_PASSWORD=请替换为本地演示密码

# ── JWT ─────────────────────────────────
JWT_SECRET=village-dev-secret-change-me
JWT_REFRESH_SECRET=village-dev-refresh-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Ollama 本地 AI ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# 7B 更聪明（q4 约 4.7GB，8GB 显存可跑）；显存紧张可降到 qwen2.5:3b-instruct-q4_K_M
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_VISION_MODEL=minicpm-v:8b-2.6-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3

# ── 反向代理信任（Express trust proxy） ──
# 控制 Express 对 X-Forwarded-For 的信任策略。
# 不设置 / false / 0：直连模式，忽略所有 XFF（本地开发安全默认）。
# loopback：信任本机反向代理（nginx/caddy 等），解析真实客户端 IP。
# IP/CIDR 列表：逗号分隔，仅信任指定地址，如 10.0.0.1 或 10.0.0.0/24,172.16.0.1。
# 严禁设置为 true（信任任意来源 XFF），启动会拒绝。
TRUST_PROXY=false

# ── 文件上传 ────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
