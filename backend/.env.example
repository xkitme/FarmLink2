# ── 数据库 ──────────────────────────────
DATABASE_URL="file:../data/village.db"

# ── 服务 ────────────────────────────────
PORT=8000
NODE_ENV=development
# dev：本机开发；demo：比赛离线包；release：正式发布
APP_ENV=dev
# 仅 db:seed 使用；demo 必须显式设置，release 禁止执行种子脚本
# SEED_PASSWORD=请替换为本地演示密码

# ── JWT ─────────────────────────────────
JWT_SECRET=village-dev-secret-change-me
JWT_REFRESH_SECRET=village-dev-refresh-secret-change-me
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=30d

# ── Ollama 本地 AI ──────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# 7B 更聪明（q4 约 4.7GB，8GB 显存可跑）；显存紧张可降到 qwen2.5:3b-instruct-q4_K_M
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_VISION_MODEL=minicpm-v:8b-2.6-q4_K_M
OLLAMA_EMBED_MODEL=bge-m3

# ── 文件上传 ────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
