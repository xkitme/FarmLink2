// 数字乡村助农 — Prisma Schema
// 分段 01：仅 User 表（骨架可启动）。完整 40+ 表见分段 02。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// 用户主表
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  nickname     String?
  passwordHash String
  phone        String?  @unique
  avatarUrl    String?
  role         String   @default("FARMER") // FARMER/BIGFARMER/VILLAGE/EXPERT/MERCHANT/ADMIN
  regionCode   String?  // 行政区划编码（行级数据权限）
  villageName  String?
  realName     String?
  points       Int      @default(0)
  isElderMode  Boolean  @default(false)
  status       Int      @default(1) // 1正常 0禁用
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phone])
  @@index([regionCode])
  @@index([role])
  @@map("t_user")
}
