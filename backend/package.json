{
  "name": "village-backend",
  "version": "1.0.0",
  "description": "数字乡村助农 App — 后端 + 管理面板",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev":          "concurrently -n backend,admin -c bgBlue,bgGreen \"nodemon src/server.js\" \"npm run dev --prefix admin\"",
    "dev:backend":  "nodemon src/server.js",
    "dev:admin":    "npm run dev --prefix admin",
    "start":        "npm run build:admin && cross-env NODE_ENV=production node src/server.js",
    "build:admin":  "npm run build --prefix admin",
    "db:generate":  "prisma generate",
    "db:migrate":   "prisma migrate dev",
    "db:push":      "prisma db push",
    "db:seed":      "node seeds/index.js",
    "db:studio":    "prisma studio",
    "db:reset":     "prisma migrate reset",
    "install:all":  "npm install && npm install --prefix admin"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}
