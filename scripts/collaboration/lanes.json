      "allow": [
        "app/lib/main.dart",
        "app/lib/core/theme.dart",
        "app/lib/core/router.dart",
        "app/lib/core/elder_mode.dart",
        "app/lib/design_system/**",
        "app/lib/pages/home/shell_page.dart",
        "app/lib/pages/home/home_page.dart",
        "app/lib/pages/splash/splash_page.dart",
        "app/lib/widgets/common.dart",
        "app/test/**",
        "app/pubspec.yaml",
        "app/pubspec.lock",
        "docs/116h-A-*.md"
      ],
      "pending": []
    },
    "116g-B": {
      "lane": "admin",
      "note": "Admin 安全交互工单（collab/116g-admin-safety）。白名单覆盖该分支（c580d57，18 文件）的真实类别：api/layout/page/components/policies/styles/test/package + 对应文档。",
      "allow": [
        "backend/admin/src/api/**",
